<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <include layout="@layout/screen_header" />

        <LinearLayout
            android:id="@+id/stateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/stateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sinceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/note_box"
            android:padding="14dp"
            android:textColor="@color/note_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startStop"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:text="Start monitoring" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/battery"
            style="@style/OutlinePill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Allow running in the background" />

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Live readings">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monLabel1" style="@style/StatLabel" />
                        <TextView android:id="@+id/monValue1" style="@style/StatValue" android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monLabel2" style="@style/StatLabel" />
                        <TextView android:id="@+id/monValue2" style="@style/StatValue" android:textSize="24sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monLabel3" style="@style/StatLabel" />
                        <TextView android:id="@+id/monValue3" style="@style/StatValue" android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monLabel4" style="@style/StatLabel" />
                        <TextView android:id="@+id/monValue4" style="@style/StatValue" android:textSize="24sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/detailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/appMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Room">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/monitorRoomInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monitorRoomButton"
                    style="@style/OutlinePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="None" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Teach it">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Only when you know for sure which one is on. Then leave the phone still under the halogen light for 2 minutes."
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/setKahraba"
                        style="@style/OutlinePill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="It's kahraba" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/setMoteur"
                        style="@style/OutlinePill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="It's moteur" />
                </LinearLayout>
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Beeps">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testKahraba"
                        style="@style/OutlinePill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Test kahraba" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testMoteur"
                        style="@style/OutlinePill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Test moteur" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/silence"
                    style="@style/OutlinePill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stop beeping" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="More">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openLog"
                    style="@style/OutlinePill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Switch log" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareData"
                    style="@style/OutlinePill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share recordings" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Recordings are the last 7 days of light readings, as CSV files. Share them to help tune the app."
                    android:textColor="?attr/appMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

    </LinearLayout>
</ScrollView>
