<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <include layout="@layout/screen_header" />

        <!-- 1.5.01: everything to run Always-on mode is in the coloured status card, so the graph
             below fits on the first screen. Buttons are styled for the card in MonitorActivity. -->
        <LinearLayout
            android:id="@+id/stateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/stateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sinceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.92"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/stateRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startStop"
                    style="@style/OutlinePill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="14sp"
                    android:text="Start" />

                <Space
                    android:id="@+id/glanceGap"
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/glance"
                    style="@style/OutlinePill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="14sp"
                    android:text="Glance" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/teachRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setKahraba"
                    style="@style/OutlinePill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="14sp"
                    android:text="It's kahraba" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setMoteur"
                    style="@style/OutlinePill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="14sp"
                    android:text="It's moteur" />
            </LinearLayout>

            <TextView
                android:id="@+id/battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="⚠  Allow running in the background (tap here)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/note_box"
            android:padding="14dp"
            android:textColor="@color/note_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:notchTitle="Live readings">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1.5.01: the four readings in one row (value over its label). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monValue1" style="@style/StatValue" android:textSize="19sp" />
                        <TextView android:id="@+id/monLabel1" style="@style/StatLabel" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monValue2" style="@style/StatValue" android:textSize="19sp" />
                        <TextView android:id="@+id/monLabel2" style="@style/StatLabel" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monValue3" style="@style/StatValue" android:textSize="19sp" />
                        <TextView android:id="@+id/monLabel3" style="@style/StatLabel" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/monValue4" style="@style/StatValue" android:textSize="19sp" />
                        <TextView android:id="@+id/monLabel4" style="@style/StatLabel" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The light graph (hidden in Power cuts only mode). -->
                <LinearLayout
                    android:id="@+id/graphBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/graphRanges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <com.kahraba.power.HistoryChart
                        android:id="@+id/graphChart"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/graphLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/appMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/appMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Power cuts only"
                        android:textColor="?attr/appText"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="For a phone under an LED or other light. Logs when the power goes off and comes back. The light isn't used and nothing is learned."
                        android:textColor="?attr/appMuted"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/cutsOnlySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:id="@+id/roomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Room">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/monitorRoomInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monitorRoomButton"
                    style="@style/OutlinePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="None" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monitorLearned"
                    style="@style/OutlinePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="What it learned…" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="Beeps">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testKahraba"
                        style="@style/OutlinePill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Test kahraba" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testMoteur"
                        style="@style/OutlinePill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Test moteur" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/silence"
                    style="@style/OutlinePill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stop beeping" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

        <com.kahraba.power.NotchCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:notchTitle="More">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openLog"
                    style="@style/OutlinePill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Switch log" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareData"
                    style="@style/OutlinePill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share recordings" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Recordings are the last 7 days of light readings, as CSV files. Share them to help tune the app."
                    android:textColor="?attr/appMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.kahraba.power.NotchCard>

    </LinearLayout>
</ScrollView>
